# Copie este arquivo para ".env" (que deve estar no .gitignore) e preencha
# com sua API key real do Ollama Cloud. NUNCA faça commit do arquivo ".env"
# nem da chave real no histórico do Git — as condições de entrega da
# Sprint 03 penalizam exposição de credenciais.

OLLAMA_API_KEY=coloque_sua_api_key_aqui
